# PYROTECH VISION - copy this file to ".env" and adjust. Both the frontend (npm start) and the
# backend (backend/main.py) read it. Real environment variables take precedence.

# ---------------- frontend (server.js) ----------------
PORT=5173
HOST=127.0.0.1
# Where the frontend proxies /api. Set to "off" to run the UI without a backend.
BACKEND_URL=http://127.0.0.1:8000/api

# ---------------- backend (backend/main.py) ----------------
AIV_HOST=127.0.0.1
AIV_PORT=8000
# Relative paths are resolved against the backend/ folder.
AIV_MODEL=models/yolov8n.pt
AIV_TRACKER_CONFIG=models/bytetrack_stable.yaml
AIV_SNAPSHOT_DIR=snapshots
AIV_DATA_DIR=data
# Inference device: empty = auto (GPU if available), cpu, or 0 for the first CUDA GPU
AIV_DEVICE=
AIV_IMG_SIZE=640
# Camera open / first-frame timeout in seconds (per-camera timeout from the UI overrides)
AIV_CONNECT_TIMEOUT=10
# Default cooldowns (seconds) between alerts / automatic snapshots of the same class on one camera.
# Snapshots: 0 = one snapshot for every confirmed vehicle (each track is reported only once anyway).
AIV_EVENT_COOLDOWN=30
AIV_SNAPSHOT_COOLDOWN=0
# Inference engine for the same yolov8n weights: auto (OpenVINO if installed, else PyTorch) | openvino | pytorch
AIV_ENGINE=auto
# MJPEG live stream
AIV_STREAM_MAX_FPS=15
AIV_STREAM_MAX_WIDTH=1280
AIV_STREAM_JPEG_QUALITY=75
# Only needed if a browser calls the backend directly (not through npm start)
AIV_CORS_ORIGINS=
AIV_LOG_LEVEL=INFO

# Python used by start-backend.cmd. Leave empty: the backend uses its own environment
# backend\.venv, created once by setup-backend.cmd. Only set this to use another Python
# installation that has backend\requirements-lock.txt installed.
AIV_PYTHON=

# Ultralytics runs fully offline by default (no connectivity probe, no automatic pip installs,
# settings kept in backend\.ultralytics). Set to 0 / 1 to restore Ultralytics' default behaviour.
YOLO_OFFLINE=1
YOLO_AUTOINSTALL=0
