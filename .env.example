# PYROTECH VISION - copy this file to ".env" and adjust. Both the frontend (npm start) and the
# backend (backend/main.py) read it. Real environment variables take precedence.

# ---------------- frontend (server.js) ----------------
PORT=5173
HOST=127.0.0.1
# Where the frontend proxies /api. Set to "off" to run the UI without a backend.
BACKEND_URL=http://127.0.0.1:8000/api

# ---------------- backend (backend/main.py) ----------------
AIV_HOST=127.0.0.1
AIV_PORT=8000
# Relative paths are resolved against the backend/ folder.
AIV_MODEL=models/yolov8n.pt
AIV_TRACKER_CONFIG=models/bytetrack_stable.yaml
AIV_SNAPSHOT_DIR=snapshots
AIV_DATA_DIR=data
# Inference device: empty = auto (GPU if available), cpu, or 0 for the first CUDA GPU
AIV_DEVICE=
AIV_IMG_SIZE=640
# Camera open / first-frame timeout in seconds (per-camera timeout from the UI overrides)
AIV_CONNECT_TIMEOUT=10
# Default cooldowns (seconds) between alerts / automatic snapshots of the same class on one camera.
# Snapshots: 0 = one snapshot for every confirmed vehicle (each track is reported only once anyway).
AIV_EVENT_COOLDOWN=30
AIV_SNAPSHOT_COOLDOWN=0
# Inference engine for the same yolov8n weights:
#   auto (Rockchip NPU on an RK3588 board after ./aivision.sh npu setup, else OpenVINO if installed, else PyTorch)
#   | rknn | openvino | pytorch
AIV_ENGINE=auto
# Rockchip NPU (./aivision.sh npu ...): RKNN model folder (FP16 = same detections as the CPU; INT8 faster, check first),
# NPU core per model instance (rr = next core in turn, auto, 0, 1, 2, 0_1_2), runtime library (default backend/npu/)
#AIV_RKNN_MODEL=models/yolov8n_rknn_model
#AIV_NPU_CORE=rr
#AIV_RKNN_LIB=
# Fire & Smoke model engine: auto (OpenVINO if installed, about 5x faster on CPU) | openvino | pytorch
AIV_FIRE_ENGINE=auto
# Frames from each camera to its detection loop:
#   queue  = every decoded frame is analysed in order (FIFO). The queue holds at most AIV_FRAME_QUEUE_SECONDS of
#            video / AIV_FRAME_QUEUE_MAX_MB of memory per camera; when the AI cannot keep up and the queue is full,
#            the OLDEST frames are dropped and counted ("dropped (queue full)"). Longer queue = fewer drops in short
#            bursts, but more delay (up to the queue length) when a camera is overloaded for longer.
#   latest = the original behaviour: always the newest frame, frames the AI is too slow for are skipped.
AIV_FRAME_POLICY=queue
AIV_FRAME_QUEUE_SECONDS=0.5
AIV_FRAME_QUEUE_MAX_MB=96
# Latency budget of the queue in ms (0 = off: every queued frame is analysed in order). When the AI falls behind,
# frames older than this are skipped and counted ("stale") so the live view stays close to real time.
# The Colab launcher starts the backend with 200.
AIV_FRAME_MAX_LAG_MS=0
# CPU threads (CPU-only boxes). Empty = application default. Read once at start-up - restart the backend after a change.
# Measure the best values on the box itself: scripts/debian/perf-tune.sh auto   (backup + rollback included)
#   AIV_TORCH_THREADS          PyTorch threads per model call. Default: Ultralytics sets min(8, CPUs-1) for EVERY camera's
#                              model at once (e.g. 3 cameras x 7 threads on 8 CPUs) - often slower than fewer threads.
#   AIV_TORCH_INTEROP_THREADS  PyTorch inter-op pool (not used by these models; 1 saves idle threads)
#   AIV_INFER_CONCURRENCY      model calls (all cameras + fire + object workers) allowed at the same time; 0 = unlimited
#   AIV_CV_THREADS             OpenCV threads (Ultralytics switches them off by default)
#   AIV_CPU_AFFINITY           CPUs the backend may use, e.g. 4-7 (the fast cores of a big.LITTLE ARM chip)
#   AIV_OMP_WAIT_POLICY        passive | active - idle OpenMP threads sleep or spin
AIV_TORCH_THREADS=
AIV_TORCH_INTEROP_THREADS=
AIV_INFER_CONCURRENCY=
AIV_CV_THREADS=
AIV_CPU_AFFINITY=
AIV_OMP_WAIT_POLICY=
# Human Detection + Human Count on one camera share one person-detection pass (identical detections). 0 = two passes.
AIV_SHARED_PERSON_INFERENCE=1
# Scheduling mode for Human / Vehicle / Human Count / Object Monitoring (per camera: module Settings):
#   adaptive = IDLE while the scene is still (motion check inside the module's zones ~5x/s + one AI check every
#              AIV_IDLE_CHECK_SEC), ACTIVE = every frame with the original tracker confirmation while there is motion
#              in the zones, an unconfirmed object, or (Human Count) people in view; IDLE again after AIV_IDLE_AFTER_SEC
#   interval = fixed sampling (settings below)        every = every frame (original behaviour)
AIV_SCHEDULE_MODE=adaptive
AIV_IDLE_CHECK_SEC=10
AIV_IDLE_AFTER_SEC=10
# AI frame sampling (defaults for every camera; per camera: module Settings -> "AI frame sampling").
# *_INTERVAL = seconds between two AI analyses (0 = every frame, the previous behaviour). With an interval,
# Human / Vehicle detections are confirmed on ONE analysed frame (confidence >= class threshold + margin) and the
# same object at the same place is reported once per AIV_SAMPLED_DEDUPE_SEC; Human Count reports people in view
# per sample (occupancy) - unique counting needs interval 0.
# *_CAPTURE_FPS = frames per second a camera session processes / shows (the camera's own fps decides decoding).
# Motion gate (Human Detection and Object Monitoring only, never Vehicle / Count / Fire): AI runs when the picture
# changes, for AIV_MOTION_HOLD_SEC after it, and every AIV_MOTION_FALLBACK_SEC without motion.
AIV_VEHICLE_INTERVAL=2.0
AIV_VEHICLE_CAPTURE_FPS=16
AIV_HUMAN_INTERVAL=4.0
AIV_HUMAN_CAPTURE_FPS=6
AIV_COUNT_INTERVAL=4.0
AIV_HUMAN_MOTION_GATE=1
AIV_OBJECT_MOTION_GATE=1
AIV_MOTION_FALLBACK_SEC=30
AIV_MOTION_HOLD_SEC=10
AIV_MOTION_MIN_AREA_PCT=0.5
AIV_SAMPLED_CONFIRM_MARGIN=0.10
AIV_SAMPLED_DEDUPE_SEC=60
AIV_STALE_FRAME_SEC=2.0
# MJPEG live stream
AIV_STREAM_MAX_FPS=15
AIV_STREAM_MAX_WIDTH=1280
AIV_STREAM_JPEG_QUALITY=75
# Live-view JPEG encoding in its own thread per camera (never delays inference). 0 = encode inside the AI loop (old).
AIV_STREAM_ENCODER_THREAD=1
# GPU (PyTorch CUDA, AIV_DEVICE=0) only: FP16 inference auto|1|0 (auto = on with a CUDA device), NMS IoU (empty =
# Ultralytics default 0.7), warm-up passes at model load. Measure on your footage: scripts/colab/bench_vehicle.py
AIV_HALF=auto
AIV_NMS_IOU=
AIV_GPU_WARMUP=3
# Only needed if a browser calls the backend directly (not through npm start)
AIV_CORS_ORIGINS=
AIV_LOG_LEVEL=INFO

# Python used by start-backend.cmd. Leave empty: the backend uses its own environment
# backend\.venv, created once by setup-backend.cmd. Only set this to use another Python
# installation that has backend\requirements-lock.txt installed.
AIV_PYTHON=

# Ultralytics runs fully offline by default (no connectivity probe, no automatic pip installs,
# settings kept in backend\.ultralytics). Set to 0 / 1 to restore Ultralytics' default behaviour.
YOLO_OFFLINE=1
YOLO_AUTOINSTALL=0
# Far people / vehicles (Human / Vehicle "Far people", "Far / fast vehicles" options): zoomed tiles over the top part
# of the full-resolution picture. Region (fraction of the height), tiles side by side (1-4), every Nth analysed frame.
#AIV_FAR_ZOOM_REGION=0.5
#AIV_FAR_ZOOM_TILES=2
#AIV_FAR_ZOOM_EVERY=2
